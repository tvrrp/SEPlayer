# rules

--enable anyObjectProtocol
--enable blankLinesAroundMark
--enable blankLinesAtEndOfScope
--enable blankLinesAtStartOfScope
--enable blankLinesBetweenScopes
--enable braces
--enable consecutiveBlankLines
--enable consecutiveSpaces
--enable duplicateImports
--enable elseOnSameLine
--enable emptyBraces
--enable hoistPatternLet
--enable indent
--enable initCoderUnavailable
--enable leadingDelimiters
--enable linebreakAtEndOfFile
--enable linebreaks
--enable modifierOrder
--enable redundantBreak
--enable redundantExtensionACL
--enable redundantGet
--enable redundantInit
--enable redundantLet
--enable redundantLetError
--enable redundantNilInit
--enable redundantObjc
--enable redundantParens
--enable redundantPattern
--enable redundantRawValues
--enable redundantReturn
--enable redundantType
--enable redundantVoidReturnType
--enable semicolons
--enable sortImports
--enable spaceAroundBraces
--enable spaceAroundBrackets
--enable spaceAroundComments
--enable spaceAroundGenerics
--enable spaceAroundParens
--enable spaceInsideBraces
--enable spaceInsideBrackets
--enable spaceInsideComments
--enable spaceInsideGenerics
--enable spaceInsideParens
--enable trailingCommas
--enable trailingSpace
--enable typeSugar
--enable unusedArguments
--enable void
--enable wrapArguments
--enable wrapAttributes
--enable wrapEnumCases
--enable wrapSwitchCases

--disable andOperator
--disable enumNamespaces
--disable extensionAccessControl
--disable fileHeader
--disable isEmpty
--disable markTypes
--disable numberFormatting
--disable organizeDeclarations
--disable preferKeyPath
--disable redundantBackticks
--disable redundantFileprivate
--disable strongOutlets
--disable todos
--disable trailingClosures
--disable wrap
--disable wrapMultilineStatementBraces
--disable yodaConditions
--disable preferForLoop
--disable redundantSelf
--disable opaqueGenericParameters

# newer default rules that rewrite one-line bodies, merge statements or rename things
--disable headerFileName
--disable nestedIf
--disable repeatedGuard
--disable swiftTestingTestCaseNames
--disable wrapFunctionBodies
--disable wrapIfExpressionBodies
--disable wrapIfStatementBodies
--disable wrapLoopBodies
--disable wrapPropertyBodies

# options

--swiftversion 6.2
--allman false
--commas collections-only
--importgrouping alphabetized
--trimwhitespace always
--elseposition same-line
--guardelse same-line
--patternlet hoist
--indent 4
--ifdef no-indent
--indentcase false
--comments indent
--xcodeindentation enabled
--linebreaks lf
--modifierorder public,override
--semicolons inline
--operatorfunc spaced
--ranges spaced
--shortoptionals always
--stripunusedargs closure-only
--voidtype void
--wraparguments preserve
--wrapparameters preserve
--wrapcollections before-first
--funcattributes prev-line
--typeattributes prev-line

# exclude files

--exclude .build,**/.build,.swiftpm,Tools
